-- Lógica do Botão Spawn
spawnButton.MouseButton1Click:Connect(function()
	if isSpawning or #spawnedNPCs >= MAX_NPCS then
		return
	end

	isSpawning = true

	local realChar = getRealCharacter()
	if realChar and realChar:FindFirstChild("HumanoidRootPart") then
		local rootPart = realChar.HumanoidRootPart
		local count = #spawnedNPCs + 1

		local npc = Players:CreateHumanoidModelFromUserId(TARGET_USER_ID)
		npc.Name = "DAMIZZ V" .. count

		local spawnCFrame = rootPart.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.rad(180), 0)
		npc:SetPrimaryPartCFrame(spawnCFrame)
		npc.Parent = workspace

		table.insert(spawnedNPCs, npc)

		local humanoid = npc:FindFirstChildOfClass("Humanoid")
		local head = npc:FindFirstChild("Head")

		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None

			pcall(function()
				local description = Players:GetHumanoidDescriptionFromUserId(TARGET_USER_ID)
				humanoid:ApplyDescription(description)
			end)

			local playerAnimate = realChar:FindFirstChild("Animate")
			if playerAnimate then
				local oldAnimate = npc:FindFirstChild("Animate")
				if oldAnimate then oldAnimate:Destroy() end
				local newAnimate = playerAnimate:Clone()
				newAnimate.Parent = npc
				newAnimate.Disabled = false
			end
		end

		if head then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "RainbowName"
			billboard.Size = UDim2.new(0, 120, 0, 30)
			billboard.StudsOffset = Vector3.new(0, 2, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = head

			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			textLabel.Text = "By DAMIZZ"
			textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			textLabel.TextScaled = true
			textLabel.Font = Enum.Font.FredokaOne
			textLabel.Parent = billboard

			local uiGradient = Instance.new("UIGradient")
			uiGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(170, 0, 255)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 170, 255)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(255, 0, 50)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 105, 180))
			})
			uiGradient.Parent = textLabel

			task.spawn(function()
				local tween = TweenService:Create(uiGradient, TweenInfo.new(3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Rotation = 360})
				tween:Play()
			end)
		end

		addNpcToList(npc, count)
	end

	isSpawning = false
end)
