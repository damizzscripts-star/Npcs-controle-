-- Acessa o PlayerModule para movimentação
local PlayerModule = require(player.PlayerScripts:WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local function getRealCharacter()
	if originalCharacter and originalCharacter.Parent and originalCharacter:FindFirstChildOfClass("Humanoid") then
		return originalCharacter
	end
	return nil
end

-- Atualiza a visibilidade dos ícones redondos verdes de indicação
local function updateControlIndicators()
	for npc, indicator in pairs(activeIndicators) do
		if indicator and indicator.Parent then
			indicator.Visible = (activeTarget == npc)
		end
	end
end

-- Função para restaurar o controle total para o personagem principal
local function resetToOriginalCharacter()
	local realChar = getRealCharacter()
	local camera = Workspace.CurrentCamera

	activeTarget = nil
	updateControlIndicators()

	if realChar then
		player.Character = realChar
		local realHumanoid = realChar:FindFirstChildOfClass("Humanoid")
		if realHumanoid then
			realHumanoid.WalkSpeed = 16
			realHumanoid.JumpPower = 50
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = realHumanoid
		end
		Controls:Enable(true)
	end
end

-- Alterna o controle do jogador entre o NPC e o personagem principal
local function setControlledCharacter(targetModel)
	local camera = Workspace.CurrentCamera
	local realChar = getRealCharacter()

	if targetModel and targetModel ~= realChar and targetModel:FindFirstChildOfClass("Humanoid") then
		activeTarget = targetModel
		updateControlIndicators()
		local npcHumanoid = targetModel:FindFirstChildOfClass("Humanoid")

		if realChar then
			local realHumanoid = realChar:FindFirstChildOfClass("Humanoid")
			if realHumanoid then
				realHumanoid.WalkSpeed = 0
				realHumanoid.JumpPower = 0
			end

			player.Character = targetModel
			camera.CameraType = Enum.CameraType.Custom
			camera.CameraSubject = npcHumanoid
			Controls:Enable(true)
		end
	else
		resetToOriginalCharacter()
	end
end

