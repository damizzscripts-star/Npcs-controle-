			npcModel:Destroy()
		end
		itemFrame:Destroy()

		for i, v in ipairs(spawnedNPCs) do
			if v == npcModel then
				table.remove(spawnedNPCs, i)
				break
			end
		end
		spawnButton.Text = "SPAWN (" .. #spawnedNPCs .. "/" .. MAX_NPCS .. ")"
	end)
